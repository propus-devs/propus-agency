# URL pública del sitio (opcional). Sin definir vale https://propus.es, que es
# lo correcto en producción. Solo se define en un entorno distinto (preview,
# staging). Se lee al compilar: cambiarla exige reconstruir la imagen.
# NEXT_PUBLIC_SITE_URL=https://propus.es

# ── Admin y reservas ─────────────────────────────────────────────────────────
# En producción estas tres variables viven SOLO en Easypanel (servicio propus →
# Entorno). No se suben al repositorio, que es público.
#
# Base de datos Postgres. En Easypanel: la "URL de conexión interna" del
# servicio propus-db. En local: `npm run db:dev` levanta una base embebida en el
# puerto 5433 (sin Docker) y esta línea en .env.local la usa.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# La base embebida de desarrollo solo admite una conexión a la vez: en local,
# además, DATABASE_POOL_MAX=1. En producción no se define.
# DATABASE_POOL_MAX=1
#
# Contraseña del admin y secreto de la cookie de sesión. Se generan los dos con
# `npm run admin:password`. Sin ellos el admin queda cerrado (no hay contraseña
# por defecto).
# ADMIN_PASSWORD_HASH=
# AUTH_SECRET=

# Escena de Spline del hero (sólo desarrollo).
#
# Si está definida, `npm run dev` carga la escena directamente desde Spline en
# lugar de public/spline/logo.splinecode, de modo que basta con republicar en el
# editor y recargar la página para ver los cambios. En producción se ignora:
# allí siempre se sirve la copia del repositorio.
#
# Cuando la escena te convenza, congélala con `pnpm run spline:pull`.
NEXT_PUBLIC_SPLINE_SCENE=https://prod.spline.design/L6mCzNR38flmxHnK/scene.splinecode
